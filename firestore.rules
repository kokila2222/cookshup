rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Recipes collection
    match /recipes/{recipeId} {
      // Anyone can read recipes marked as public (for feeds)
      allow read: if true;

      // Only authenticated users can create recipes, and uid must match
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      // Any authenticated user can "like" a recipe (only update the likes field)
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);

      // Only the recipe owner can fully update or delete
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
