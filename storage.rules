rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Recipe photos: users can only upload to their own folder
    match /recipes/{userId}/{allPaths=**} {
      // Anyone can read recipe photos (they're displayed in feeds)
      allow read: if true;

      // Only the owner can upload/delete their photos
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // max 10MB per file
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }
  }
}
